# Auto-generated from the Nix config by nixdiag. Do not edit.
# Regenerate: nixdiag gen
style.fill: "transparent"
vars: {
  appFill: "#1c2e4a"
  appStroke: "#7fa7e8"
  infraFill: "#4a3413"
  infraStroke: "#d9995a"
  baseFill: "#2a2a2e"
  baseStroke: "#666"
  hostFill: "#181825"
  hostStroke: "#a6adc8"
  progFill: "#1e3a24"
  hostCloud: "#3d3517"
  public: "#e74c3c"
  lan: "#2ecc71"
  mesh: "#7fa7e8"
}
direction: right

diddy: "diddy" { shape: cloud; style.fill: ${hostCloud}; style.bold: true }
epstein: "epstein" { shape: cloud; style.fill: ${hostCloud}; style.bold: true }

hosts: "hosts" {
  diddy: "diddy" {
    default_nix: "default.nix" { shape: page
      svc_tailscale: "tailscale" { shape: oval; style.fill: ${appFill} }
    }
  }
  epstein: "epstein" {
    default_nix: "default.nix" { shape: page }
  }
}
modules: "modules" {
  common_nix: "common.nix" { shape: page }
  mesh_nix: "mesh.nix" { shape: page
    svc_headscale: "headscale" { shape: oval; style.fill: ${appFill} }
  }
  monitoring_nix: "monitoring.nix" { shape: page
    svc_grafana: "grafana" { shape: oval; style.fill: ${appFill} }
  }
  upstreams_nix: "upstreams.nix" { shape: page }
  web_nix: "web.nix" { shape: page
    svc_nginx: "nginx" { shape: oval; style.fill: ${appFill} }
  }
}

# host -> entry module
diddy -> hosts.diddy.default_nix
epstein -> hosts.epstein.default_nix

# module imports
hosts.diddy.default_nix -> modules.common_nix
hosts.diddy.default_nix -> modules.monitoring_nix
hosts.epstein.default_nix -> modules.common_nix
hosts.epstein.default_nix -> modules.mesh_nix
hosts.epstein.default_nix -> modules.web_nix
modules.web_nix -> modules.upstreams_nix
