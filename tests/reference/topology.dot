digraph {
  graph [rankdir=LR, fontname="sans-serif", fontcolor="#cdd6f4", bgcolor="transparent"];
  node [fontname="sans-serif", fontcolor="#cdd6f4", shape=box, style="rounded,filled", fillcolor="#2a2a2e", color="#666"];
  edge [fontname="sans-serif", fontsize=11, fontcolor="#cdd6f4", color="#a6adc8"];
  "internet" [label="🌐 Internet", shape=ellipse, fillcolor="#181825", color="#e74c3c"];
  "lan" [label="🏠 LAN", shape=ellipse, fillcolor="#181825", color="#2ecc71"];
  subgraph cluster_0 {
    label=<<B>🖥️ jerry</B>>;
    fillcolor="#181825";
    color="#a6adc8";
    style="rounded,filled";
    "jerry/headscale" [label="headscale\n(mesh control)", fillcolor="#4a3413", color="#d9995a"];
    "jerry/nginx" [label="nginx\n(proxy)", fillcolor="#4a3413", color="#d9995a"];
    "jerry/+base" [label="+ 11 system services", fontsize=11];
  }
  subgraph cluster_1 {
    label=<<B>🖥️ tom</B>>;
    fillcolor="#181825";
    color="#a6adc8";
    style="rounded,filled";
    "tom/exporter" [label="exporter", fillcolor="#1c2e4a", color="#7fa7e8"];
    "tom/grafana" [label="grafana\n(monitor)", fillcolor="#4a3413", color="#d9995a"];
    "tom/tailscale" [label="tailscale\n(mesh node)", fillcolor="#4a3413", color="#d9995a"];
    "tom/+base" [label="+ 11 system services", fontsize=11];
  }
  "internet" -> "jerry/nginx" [label="hs.ts.example :443", color="#e74c3c"];
  "jerry/nginx" -> "tom/grafana" [label="grafana :3000", color="#7fa7e8"];
  "jerry/nginx" -> "jerry/headscale" [label="hs :8080", color="#7fa7e8"];
  "tom/grafana" -> "tom/exporter" [label="scrapes", color="#7fa7e8"];
  "tom/tailscale" -> "jerry/nginx" [label="mesh", color="#7fa7e8"];
  "tom/tailscale" -> "lan" [label="advertise 192.168.1.0/24", color="#2ecc71"];
}
