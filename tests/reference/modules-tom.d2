...@theme

"tom": "tom" {class: host}
"hosts/tom/default.nix": "hosts/tom/default.nix" {
  class: file
  "tailscale": "service"
}
"modules/common.nix": "modules/common.nix" {class: file}
"modules/monitoring.nix": "modules/monitoring.nix" {
  class: file
  "grafana": "service"
}
"tom" -> "hosts/tom/default.nix" {class: arrow}
"hosts/tom/default.nix" -> "modules/common.nix" {class: arrow}
"hosts/tom/default.nix" -> "modules/monitoring.nix" {class: arrow}
