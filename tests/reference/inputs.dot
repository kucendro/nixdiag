digraph {
  graph [rankdir=LR, fontname="sans-serif", fontcolor="#cdd6f4", bgcolor="transparent"];
  node [fontname="sans-serif", fontcolor="#cdd6f4", shape=box, style="rounded,filled", fillcolor="#2a2a2e", color="#666"];
  edge [fontname="sans-serif", fontsize=11, fontcolor="#cdd6f4", color="#a6adc8"];
  root [label=<<B>this flake</B>>, fillcolor="#3d3517", color="#a6adc8"];
  nixpkgs [label="nixpkgs 56c02bc", color="#e74c3c", penwidth=2.5];
  nixpkgs_2 [label="nixpkgs_2 89570f2", color="#e74c3c", penwidth=2.5];
  stylix [label="stylix"];
  utils [label="utils"];
  utils_2 [label="utils_2"];
  root -> nixpkgs;
  root -> stylix;
  root -> utils;
  stylix -> nixpkgs_2 [label="nixpkgs"];
  stylix -> utils [label="systems", color="#7fa7e8", style="dashed"];
  stylix -> utils_2 [label="utils"];
}
