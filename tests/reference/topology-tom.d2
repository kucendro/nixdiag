...@theme

direction: down
"tom": "🖥️ tom" {
  class: machine
  "exporter": "exporter" {class: app}
  "grafana": "grafana\nmonitor\n3000/tcp" {
    class: infra
    tooltip: "Dashboards over the exporter's metrics."
  }
  "tailscale": "tailscale\nmesh node" {class: infra}
}
":lan": "🏠 LAN" {class: net-lan}
":mesh": "🔒 Mesh" {class: net-mesh}
"jerry/nginx": "jerry / nginx" {
  class: ghost
  link: "./hosts.html#host-jerry"
}
":mesh" -> "tom"."grafana": "grafana.ts.example :3000" {class: mesh}
"jerry/nginx" -> "tom"."grafana": "grafana :3000" {class: flow}
"tom"."grafana" -> "tom"."exporter": "scrapes" {class: local}
"tom"."tailscale" -> "jerry/nginx": "mesh" {class: flow}
"tom"."tailscale" -> ":lan": "advertise 192.168.1.0/24" {class: lan}
