...@theme

direction: down
"jerry": "🖥️ jerry" {
  class: machine
  "headscale": "headscale\nmesh control\n8080/tcp" {class: infra}
  "nginx": "nginx\nproxy\n80/tcp, 443/tcp" {class: infra}
}
":internet": "🌐 Internet" {class: net-public}
":mesh": "🔒 Mesh" {class: net-mesh}
"tom/grafana": "tom / grafana" {
  class: ghost
  link: "./hosts.html#host-tom"
}
"tom/tailscale": "tom / tailscale" {
  class: ghost
  link: "./hosts.html#host-tom"
}
":mesh" -> "jerry"."nginx": "grafana.ts.example :443" {class: mesh}
":internet" -> "jerry"."nginx": "hs.ts.example :443" {class: public}
"jerry"."nginx" -> "tom/grafana": "grafana :3000" {class: flow}
"jerry"."nginx" -> "jerry"."headscale": "hs :8080" {class: local}
"tom/tailscale" -> "jerry"."nginx": "mesh" {class: flow}
