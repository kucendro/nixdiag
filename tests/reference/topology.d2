...@theme

direction: down
":internet": "🌐 Internet" {class: net-public}
":lan": "🏠 LAN" {class: net-lan}
":mesh": "🔒 Mesh" {class: net-mesh}
"jerry": "🖥️ jerry" {
  class: table
  link: "./hosts.html#host-jerry"
  "headscale": "8080/tcp" {constraint: "mesh control"}
  "nginx": "80/tcp, 443/tcp" {constraint: "proxy"}
}
"tom": "🖥️ tom" {
  class: table
  link: "./hosts.html#host-tom"
  "exporter": "—"
  "grafana": "3000/tcp" {constraint: "monitor"}
  "tailscale": "—" {constraint: "mesh node"}
}
":mesh" -> "tom"."grafana": "grafana.ts.example :3000" {class: mesh}
":mesh" -> "jerry"."nginx": "grafana.ts.example :443" {class: mesh}
":internet" -> "jerry"."nginx": "hs.ts.example :443" {class: public}
"tom"."tailscale" -> ":lan": "advertise 192.168.1.0/24" {class: lan}
"jerry"."nginx" -> "tom"."grafana": "grafana :3000" {class: flow}
"tom"."tailscale" -> "jerry"."nginx": "mesh" {class: flow}
