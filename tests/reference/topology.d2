  infraStroke: "#d9995a"
  baseFill: "#2a2a2e"
  baseStroke: "#666"
  hostFill: "#181825"
  hostStroke: "#a6adc8"
  progFill: "#1e3a24"
  hostCloud: "#3d3517"
  public: "#e74c3c"
  lan: "#2ecc71"
  mesh: "#7fa7e8"
}
direction: right
classes: {
  app: { style: { fill: ${appFill}; stroke: ${appStroke} } }
  infra: { style: { fill: ${infraFill}; stroke: ${infraStroke} } }
  base: { style: { fill: ${baseFill}; stroke: ${baseStroke}; font-size: 13 } }
}

internet: "🌐 Internet" { shape: cloud; style: { fill: ${hostFill}; stroke: ${public} } }
lan: "🏠 LAN" { shape: cloud; style: { fill: ${hostFill}; stroke: ${lan} } }

diddy: "🖥️ diddy" {
  style: { fill: ${hostFill}; stroke: ${hostStroke}; bold: true }
  tailscale: "tailscale\n(mesh node)" { class: app }
  grafana: "grafana\n(monitor)" { class: infra }
  base: "+ 11 system services" { class: base }
}
epstein: "🖥️ epstein" {
  style: { fill: ${hostFill}; stroke: ${hostStroke}; bold: true }
  headscale: "headscale\n(mesh control)" { class: infra }
  nginx: "nginx\n(proxy)" { class: infra }
  base: "+ 11 system services" { class: base }
}

# data-flow edges
internet -> epstein.headscale: "hs.ts.example :443" { style.stroke: ${public} }
diddy.tailscale -> epstein.headscale: "mesh" { style.stroke: ${mesh} }
