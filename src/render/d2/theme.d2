direction: right

classes: {
  root: {style: {fill: ${hostCloud}; stroke: ${hostStroke}; font-color: ${ink}; bold: true; border-radius: 6}}
  node: {style: {fill: ${baseFill}; stroke: ${baseStroke}; font-color: ${ink}; bold: false; border-radius: 6}}
  flagged: {style: {fill: ${baseFill}; stroke: ${public}; stroke-width: 3; font-color: ${ink}; bold: false; border-radius: 6}}
  arrow: {style: {stroke: ${line}; font-color: ${ink}}}
  follows: {style: {stroke: ${mesh}; stroke-dash: 4; font-color: ${ink}}}
  host: {shape: oval; style: {fill: ${hostCloud}; stroke: ${hostStroke}; font-color: ${ink}; bold: true}}
  table: {shape: sql_table; style: {fill: ${hostStroke}; stroke: ${baseFill}; font-color: ${hostFill}}}
  machine: {style: {fill: ${hostFill}; stroke: ${hostStroke}; stroke-width: 2; font-color: ${ink}; bold: true; border-radius: 8}}
  infra: {style: {fill: ${infraFill}; stroke: ${infraStroke}; font-color: ${ink}; bold: false; border-radius: 6}}
  app: {style: {fill: ${appFill}; stroke: ${appStroke}; font-color: ${ink}; bold: false; border-radius: 6}}
  ghost: {style: {fill: ${baseFill}; stroke: ${baseStroke}; stroke-dash: 3; font-color: ${ink}; bold: false; border-radius: 6}}
  net-public: {shape: cloud; style: {fill: ${hostFill}; stroke: ${public}; stroke-width: 2; font-color: ${ink}; bold: true}}
  net-lan: {shape: cloud; style: {fill: ${hostFill}; stroke: ${lan}; stroke-width: 2; font-color: ${ink}; bold: true}}
  net-mesh: {shape: cloud; style: {fill: ${hostFill}; stroke: ${mesh}; stroke-width: 2; stroke-dash: 4; font-color: ${ink}; bold: true}}
  public: {style: {stroke: ${public}; stroke-width: 2; font-color: ${ink}}}
  lan: {style: {stroke: ${lan}; stroke-width: 2; font-color: ${ink}}}
  mesh: {style: {stroke: ${mesh}; stroke-width: 2; stroke-dash: 5; font-color: ${ink}}}
  flow: {style: {stroke: ${ink}; stroke-width: 2; font-color: ${ink}}}
  local: {style: {stroke: ${line}; stroke-dash: 2; font-color: ${ink}}}
  control: {style: {stroke: ${mesh}; stroke-width: 1; stroke-dash: 2; font-color: ${ink}}}
  mgmt: {style: {stroke: ${line}; stroke-width: 1; stroke-dash: 8; font-color: ${ink}}}
  route: {style: {stroke: ${mesh}; stroke-width: 2; stroke-dash: 6; font-color: ${ink}}}
  location: {style: {fill: transparent; stroke: ${line}; stroke-dash: 6; stroke-width: 2; font-color: ${ink}; bold: true; border-radius: 12}}
}
